# Copy this file to .env (same folder as app.py) and fill in only what you need.
# The app runs without any of these; features that need a key show a clear message instead.

# Session signing key. Leave empty to let the app create one in database/.secret_key
SECRET_KEY=

# Market prices (data.gov.in, free key): https://data.gov.in  -> My account -> API key
MARKET_API_KEY=
# Optional: the dataset resource id, if data.gov.in changes it
MARKET_RESOURCE_ID=

# AI farming chatbot (Anthropic API key, from console.anthropic.com). Server-side only.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-5-5)
CHAT_MODEL=

# Shown on the home page contact section (optional)
CONTACT_EMAIL=

# Set to 1 only when the site is served over HTTPS
HTTPS_ONLY=0

# Plant.id API (disease analysis)
PLANT_HEALTH_API_KEY=
